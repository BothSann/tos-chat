{
  "name": "tos-chat",
  "version": "0.1.0",
  "private": true,
  "description": "Chat app for learning NestJS: Next.js web + NestJS api",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.13.0",
      "onFail": "download"
    }
  }
}
