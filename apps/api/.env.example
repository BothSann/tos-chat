# Copy to .env (dev) and .env.test (e2e). Both are git-ignored.
NODE_ENV=development
PORT=4000
# Dev database. Use 127.0.0.1, not localhost (IPv6 ::1 misses the Docker port).
DATABASE_URL=postgresql://tos:tos@127.0.0.1:5432/tos_chat

# .env.test holds only this line, pointing at the disposable test database:
# DATABASE_URL=postgresql://tos:tos@127.0.0.1:5433/tos_chat_test

# Better Auth. Secret: 32+ random chars, from
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# URL: the web origin, because the browser reaches auth through the web proxy.
BETTER_AUTH_SECRET=replace-with-32-or-more-random-characters
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth App (github.com → Settings → Developer settings → OAuth Apps).
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
